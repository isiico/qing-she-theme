  // 根据词法编译的高亮语法
  "tokenColors": [
    // ============================================
    // 🌍 [必须放在最前] 通用语法高亮基础层
    // 解决 Kotlin, Java, Python 等没有单独配置的语言变单色问题
    // ============================================
    {
      "name": "[Universal] Keywords",
      "scope": [
        "source keyword",
        "source storage.type",
        "source storage.modifier"
      ],
      "settings": {
        "foreground": "#ba8ef7"
      }
    },
    {
      "name": "[Universal] Strings",
      "scope": ["source string", "source string.quoted"],
      "settings": {
        "foreground": "#5bec95"
      }
    },
    {
      "name": "[Universal] Comments",
      "scope": ["source comment", "source punctuation.definition.comment"],
      "settings": {
        "foreground": "#707a84"
      }
    },
    {
      "name": "[Universal] Functions",
      "scope": [
        "source entity.name.function",
        "source support.function",
        "source meta.function-call"
      ],
      "settings": {
        "foreground": "#ffea6b"
      }
    },
    {
      "name": "[Universal] Classes & Types",
      "scope": [
        "source entity.name.type",
        "source support.class",
        "source support.type",
        "source entity.name.class"
      ],
      "settings": {
        "foreground": "#5fb5f3"
      }
    },
    {
      "name": "[Universal] Numbers",
      "scope": ["source constant.numeric"],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "name": "[Universal] Operators",
      "scope": [
        "source keyword.operator",
        "source punctuation.separator",
        "source punctuation.terminator"
      ],
      "settings": {
        "foreground": "#939da5"
      }
    },
    {
      "name": "[Universal] Variables",
      "scope": [
        "source variable",
        "source variable.other",
        "source variable.parameter"
      ],
      "settings": {
        "foreground": "#a6c1e4"
      }
    },

    // ============================================
    // 🎨 全局兜底规则 (Global Override)
    // ============================================
    {
      "name": "Global Light Text Override",
      "scope": [
        "source", // 所有代码
        "text", // 普通文本
        "variable",
        "constant",
        "keyword"
      ],
      "settings": {
        "foreground": "#a6c1e4"
      }
    },
    // 基础标点符号 -> 灰色
    {
      "name": "Normal Punctuation",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.string",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#707a84"
      }
    },

    // ============================================
    // 🌐 HTML 专属配置 (修复 HTML 变单色问题)
    // ============================================
    {
      "name": "HTML: Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "markup.deleted.git_gutter"
      ],
      "settings": {
        "foreground": "#ff6a80" // 粉色 (<div>)
      }
    },
    {
      "name": "HTML: Attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#ffa763" // 橙色 (class=)
      }
    },
    {
      "name": "HTML: Attribute Values",
      "scope": ["string.quoted.double.html", "string.quoted.single.html"],
      "settings": {
        "foreground": "#5bec95" // 绿色 ("container")
      }
    },
    {
      "name": "HTML: Brackets (< >)",
      "scope": [
        "punctuation.definition.tag",
        "punctuation.definition.tag.html",
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.end.html"
      ],
      "settings": {
        "foreground": "#707a84" // 灰色 (< >)
      }
    },
    {
      "name": "HTML: Doctypes / Meta",
      "scope": ["meta.tag.metadata.doctypedecl", "meta.tag.metadata.doctype"],
      "settings": {
        "foreground": "#ba8ef7"
      }
    },

    // ============================================
    // 📝 Markdown (MD) 专属优化层
    // ============================================
    {
      "name": "Markdown: Headings",
      "scope": [
        "markdown.heading",
        "markup.heading",
        "markup.heading entity.name",
        "markup.heading.markdown punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#5bec95",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown: Bold",
      "scope": ["markup.bold", "markup.bold string"],
      "settings": {
        "foreground": "#ba8ef7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown: Italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#ba8ef7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown: Code",
      "scope": [
        "markup.raw",
        "markup.inline.raw",
        "markup.raw.block.markdown",
        "markup.raw.block.fenced.markdown"
      ],
      "settings": {
        "foreground": "#ffea6b"
      }
    },
    {
      "name": "Markdown: Link Text",
      "scope": ["string.other.link.title.markdown"],
      "settings": {
        "foreground": "#5fb5f3"
      }
    },
    {
      "name": "Markdown: Link URL",
      "scope": [
        "markup.underline.link",
        "constant.other.reference.link.markdown"
      ],
      "settings": {
        "foreground": "#89ddff",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown: Blockquote",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#939da5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown: List Punctuation",
      "scope": ["punctuation.definition.list_item.markdown"],
      "settings": {
        "foreground": "#ffd700"
      }
    },
    {
      "name": "Markdown: Separator",
      "scope": ["meta.separator"],
      "settings": {
        "foreground": "#707a84",
        "fontStyle": "bold"
      }
    },

    // ============================================
    // ⚛️ Vue / Angular / General Fixes
    // ============================================
    {
      "name": "Vue/Angular Directives",
      "scope": [
        "punctuation.attribute-shorthand.event",
        "punctuation.attribute-shorthand.bind",
        "punctuation.attribute-shorthand.slot",
        "entity.other.attribute-name.angular",
        "punctuation.definition.keyword",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },

    // ============================================
    // 🔷 TS 专属配置 (2025.12.15 更新版)
    // ============================================
    {
      "name": "TS Only: Control Keywords",
      "scope": [
        "source.ts keyword.control",
        "source.ts keyword.control.import",
        "source.ts keyword.control.export",
        "source.ts keyword.control.flow"
      ],
      "settings": {
        "foreground": "#ba8ef7"
      }
    },
    {
      "name": "TS Only: Storage Keywords",
      "scope": ["source.ts storage.type", "source.ts storage.modifier"],
      "settings": {
        "foreground": "#ba8ef7"
      }
    },
    {
      "name": "TS Only: Types & Classes",
      "scope": [
        "source.ts entity.name.type",
        "source.ts support.class",
        "source.ts support.type",
        "source.ts entity.name.class",
        "source.ts meta.return.type",
        "source.ts meta.type.annotation"
      ],
      "settings": {
        "foreground": "#5fb5f3"
      }
    },
    {
      "name": "TS Only: Function Parameters",
      "scope": ["source.ts variable.parameter"],
      "settings": {
        "foreground": "#ffa763"
      }
    },
    {
      "name": "TS Only: Angular Decorator Array Items",
      "scope": [
        "source.ts meta.decorator meta.array.literal variable.other.readwrite",
        "source.ts meta.decorator meta.array.literal variable.other.object"
      ],
      "settings": {
        "foreground": "#ffd700"
      }
    },
    {
      "name": "TS Only: Properties",
      "scope": [
        "source.ts variable.other.property",
        "source.ts variable.object.property",
        "source.ts meta.field.declaration variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#ffea6b"
      }
    },
    {
      "name": "TS Only: Object Keys",
      "scope": [
        "source.ts meta.object-literal.key",
        "source.ts variable.other.property.ts"
      ],
      "settings": {
        "foreground": "#939da5"
      }
    },
    {
      "name": "TS Only: 'this' keyword",
      "scope": ["source.ts variable.language.this"],
      "settings": {
        "foreground": "#939da5"
      }
    },
    {
      "name": "TS Only: Method Calls",
      "scope": [
        "source.ts meta.function-call entity.name.function",
        "source.ts meta.method-call entity.name.function"
      ],
      "settings": {
        "foreground": "#ba8ef7"
      }
    },
    // [精准修复] TS 中的内联 Style 属性
    {
      "name": "TS Only: Inline Style CSS Attribute",
      "scope": [
        "source.ts meta.attribute.style.html source.css",
        "source.ts meta.attribute.style.html source.css support.type.property-name.css",
        "source.ts meta.attribute.style.html source.css meta.property-value.css",
        "source.ts meta.attribute.style.html source.css constant.numeric.css",
        "source.ts meta.attribute.style.html source.css keyword.other.unit.css",
        "source.ts meta.attribute.style.html source.css punctuation.separator.key-value.css",
        "source.ts meta.attribute.style.html source.css punctuation.terminator.rule.css"
      ],
      "settings": {
        "foreground": "#5bec95"
      }
    },
    // 11. [补丁] 修复内联 Style 属性的引号颜色 (变回灰色)
    // 必须放在 "Inline Style CSS Attribute" 规则之后
    {
      "name": "TS Only: Inline Style Quotes Fix",
      "scope": [
        "source.ts meta.attribute.style.html punctuation.definition.string.begin.html",
        "source.ts meta.attribute.style.html punctuation.definition.string.end.html",
        "source.ts meta.attribute.style.html punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#707a84" // 符号灰
      }
    }
  ]
}
