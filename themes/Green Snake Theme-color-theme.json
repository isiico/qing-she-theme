  // 根据词法编译的高亮语法
  "tokenColors": [
    // 专门针对所有“代码源文件” (source) 和 “纯文本” (text)，强制变回浅色！
    // 这样主编辑器就恢复正常了（深底浅字）。
    {
      "name": "Global Light Text Override",
      "scope": [
        "source",   // 所有代码 (ts, js, py...)
        "text",     // 普通文本
        "variable", 
        "constant",
        "keyword"
      ],
      "settings": {
        "foreground": "#a6c1e4" // 这里填原本的浅蓝色
      }
    }, 
    // 再次确认 Markdown (Chat内容) 使用深色
    // 这段要放在上面那段的【后面】，或者利用 specificity 覆盖
    {
      "name": "Markdown Dark for Chat",
      "scope": [
        "text.html.markdown",
        "markup",
        "meta.paragraph.markdown"
      ],
      "settings": {
        "foreground": "#66849C" // 深色，适配 Chat 背景
      }
    },
    // 专门针对基础标点强制设为浅色
    {
      "name": "Normal Punctuation",
      "scope": [
        // 基础标点
        "punctuation.separator", // = : , ;
        "punctuation.terminator", // ;
        
        // HTML/Vue 标签括号 < >
        "punctuation.definition.tag", 
        
        // 字符串引号 " '
        "punctuation.definition.string",
        
        // 对象键值对的冒号 (key: value)
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#707a84"
      }
    },
    // Vue/HTML 关键指令符号 (@ : #) -> 改成【显眼】的颜色
    {
      "name": "Vue/Angular Directives",
      "scope": [
        "punctuation.attribute-shorthand.event",  // @click 里的 @
        "punctuation.attribute-shorthand.bind",   // :src 里的 :
        "punctuation.attribute-shorthand.slot",   // #header 里的 #
        "entity.other.attribute-name.angular",    // Angular 的 *ngIf 里的 *
        "punctuation.definition.keyword",         // 有些语法把 @ 算作 keyword
        "variable.language.this"                  // this. 也可以醒目一点
      ],
      "settings": {
        "foreground": "#ffffff",
      }
    },
    {
      "name": "New keyword, logical operator keyword",
      "scope": ["keyword.operator.new", "keyword.operator.logical"],
      "settings": {
        "foreground": "#ba8ef7"
      }
    },
    {
      "name": "Comment",
      "scope": ["comment"],
      "settings": {
        "foreground": "#707a84"
      }
    },
    {
      "name": "Comment Shebang",
      "scope": ["comment.line.shebang"],
      "settings": {
        "foreground": "#ff8ad1"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "string constant.other.placeholder"],
      "settings": {
        "foreground": "#939da5"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#ff6a80"
      }
    },
    {
      "name": "Keyword, Storage",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#ba8ef7"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#939da5"
      }
    },
    {
      "name": "Operator, Misc",
      "scope": ["keyword.control"],
      "settings": {
        "foreground": "#939da5" // import，from的
      }
    },
    {
      "name": "Constant",
      "scope": ["constant.language", "variable.other.property"],
      "settings": {
        "foreground": "#ffa763"
      }
    },
    {
      "name": "Punctuation template expression",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.definition.typeparameters",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#939da5"
      }
    },
    {
      "name": "Tag, Misc",
      "scope": [
        "punctuation.definition.tag",
        "punctuation.separator.inheritance.php",
        "punctuation.definition.tag.html",
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.end.html"
